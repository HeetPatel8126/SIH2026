# Environment variables template
# Copy this file to .env and fill in the values

# LLM Configuration
LLM_PROVIDER=ollama          # ollama | openai | groq | together | anthropic
LLM_MODEL=llama3.1:8b        # model name/tag
LLM_API_KEY=                  # leave blank for Ollama
LLM_BASE_URL=http://localhost:11434  # Ollama default
LLM_TEMPERATURE=0.2          # Lower = more focused, higher = more creative
LLM_MAX_TOKENS=1024          # Max tokens in LLM response

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector DB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION=bis_documents

# Retriever
RETRIEVER_TOP_K=5             # Default number of chunks to retrieve
USE_MOCK_RETRIEVER=true       # Set to false once real vector DB is ready

# Prompt
MAX_CONTEXT_CHARS=12000       # Max chars of context to include in prompt

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

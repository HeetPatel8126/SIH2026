# Environment variables template
# Copy this file to .env and fill in the values

# LLM Configuration
LLM_PROVIDER=ollama          # ollama | openai | anthropic
LLM_MODEL=llama3.1:8b        # model name/tag
LLM_API_KEY=                  # leave blank for Ollama
LLM_BASE_URL=http://localhost:11434  # Ollama default

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector DB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION=bis_documents

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Environment variables template
# Copy this file to .env and fill in the values

# LLM Configuration (Primary)
LLM_PROVIDER=ollama          # ollama | openai | groq | together | anthropic | gemini
LLM_MODEL=qwen2.5:7b         # model name/tag
LLM_API_KEY=                  # leave blank for Ollama
LLM_BASE_URL=http://localhost:11434  # Ollama default
LLM_TEMPERATURE=0.2          # Lower = more focused, higher = more creative
LLM_MAX_TOKENS=1024          # Max tokens in LLM response

# Hybrid Fallback LLM (used when primary provider fails)
# Note: If both primary and fallback point to the same provider + URL,
# fallback is automatically skipped to avoid useless retry loops.
FALLBACK_ENABLED=true
FALLBACK_LLM_PROVIDER=ollama
FALLBACK_LLM_MODEL=qwen2.5:7b
FALLBACK_LLM_BASE_URL=http://localhost:11434
FALLBACK_LLM_API_KEY=

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector DB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION=bis_documents

# Retriever
RETRIEVER_TOP_K=5             # Default number of chunks to retrieve
USE_MOCK_RETRIEVER=true       # Set to false once real vector DB is ready

# Prompt
MAX_CONTEXT_CHARS=12000       # Max chars of context to include in prompt

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
